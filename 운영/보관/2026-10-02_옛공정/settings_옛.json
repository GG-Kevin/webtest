{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-gamchal.sh\"",
            "timeout": 15,
            "statusMessage": "감찰 점검"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-stall.sh\"",
            "timeout": 15,
            "statusMessage": "정체 점검"
          }
        ]
      }
    ]
  }
}
